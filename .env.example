# ─────────────────────────────────────────────────────────────────────────
#  CoxyClean environment variables
#
#  LOCAL:  copy this file to `.env.local` and fill in real values.
#          .env.local is gitignored — never commit real keys.
#  VERCEL: Project → Settings → Environment Variables. Add each one to
#          Production, Preview, and Development, then redeploy.
# ─────────────────────────────────────────────────────────────────────────

# ── BookingKoala (required for the lead form to confirm a booking) ───────
# Generate the key in BookingKoala:
#   Settings → General → Apps & Integrations → Make → enable → Generate API Key
BOOKINGKOALA_API_KEY=

# Your BookingKoala subdomain only — NOT the full URL.
# If your account is at https://coxyclean.bookingkoala.com, this is "coxyclean".
# Required: the API key alone does not identify your account.
BOOKINGKOALA_SUBDOMAIN=

# ── BookingKoala contract overrides (leave blank unless a call fails) ────
# BookingKoala does not publish a public REST reference, so these default to
# the conventional shape. Confirm them from Make's "Make an API Call" module
# (its URL field shows the real path) or from BookingKoala support, then set
# them here. Changing these needs no code edit.
#   default: https://<BOOKINGKOALA_SUBDOMAIN>.bookingkoala.com
BOOKINGKOALA_API_BASE=
#   default: /api/v1/leads
BOOKINGKOALA_LEAD_PATH=
#   default: api-key
BOOKINGKOALA_AUTH_HEADER=

# How the confirmed Make field labels ("First Name", "Phone Number",
# "Referrer Path", ...) are spelled on the wire. Make shows human labels, not
# JSON keys, so if BookingKoala rejects the field names, work down this list:
#   snake  (default)  first_name, phone_number, referrer_path
#   camel             firstName,  phoneNumber,  referrerPath
#   pascal            FirstName,  PhoneNumber,  ReferrerPath
#   title             "First Name", "Phone Number", "Referrer Path"
# The failure log names the exact keys that were rejected.
BOOKINGKOALA_FIELD_CASE=

# ── Fallback notification (strongly recommended) ─────────────────────────
# Used ONLY when BookingKoala fails, so a lead is never lost. Without this,
# a failed lead survives only in the Vercel runtime logs.
# Free key from https://resend.com — no domain setup needed to start.
RESEND_API_KEY=
# Where failed leads get emailed. Comma-separate for more than one.
LEAD_NOTIFY_TO=
# Optional. Defaults to Resend's shared sender, which works immediately.
# Switch to something@coxyclean.com once that domain is verified in Resend.
LEAD_NOTIFY_FROM=
# Optional second channel — any Slack/Discord/Zapier incoming webhook URL.
LEAD_FALLBACK_WEBHOOK_URL=

# ── Hiring form ──────────────────────────────────────────────────────────
# Optional. Where job applications are emailed. Falls back to LEAD_NOTIFY_TO.
CAREERS_NOTIFY_TO=

# ── Diagnostics ──────────────────────────────────────────────────────────
# Optional. Set to any random string to enable GET /api/lead?token=...
# which reports which variables are set and what URL the lead call resolves
# to (never the secrets). The route 404s while this is unset.
LEAD_DIAGNOSTIC_TOKEN=
